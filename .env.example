# Copia este archivo como .env y completa lo que necesites.
# dui-IA usa LiteLLM: sirve cualquier proveedor en la nube o un modelo local.

# --- Modelo ---------------------------------------------------------------
# Formato "proveedor/modelo". Ejemplos:
#   gemini/gemini-2.5-flash        (requiere GEMINI_API_KEY)
#   openai/gpt-4o-mini             (requiere OPENAI_API_KEY)
#   anthropic/claude-sonnet-5-5    (requiere ANTHROPIC_API_KEY)
#   ollama_chat/llama3.1           (local, sin API key; ver DUI_API_BASE)
#   lm_studio/qwen2.5-7b-instruct  (local, sin API key; ver DUI_API_BASE)
DUI_MODEL=gemini/gemini-3.8-flash

# Solo para modelos locales o servidores propios:
#   Ollama:    http://localhost:11434
#   LM Studio: http://localhost:1234/v1
# DUI_API_BASE=http://localhost:11434

# --- API keys (solo la del proveedor que uses) ------------------------------
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Alcance permitido -----------------------------------------------------
# Por defecto solo se pueden escanear redes privadas/locales (192.168.x.x,
# 10.x.x.x, 127.0.0.1...). Agrega aquí, separados por comas, otros objetivos
# que tengas AUTORIZACIÓN para analizar:
# DUI_SCOPE=203.0.113.0/24,scanme.nmap.org

# --- Opcional ----------------------------------------------------------------
# DUI_MAX_TURNS=20
# DUI_TEMPERATURE=0.2
# DUI_DATA_DIR=        (por defecto: %LOCALAPPDATA%\dui-IA o ~/.local/share/dui-IA)
# DUI_REPORTS_DIR=     (por defecto: <DUI_DATA_DIR>/reports)
